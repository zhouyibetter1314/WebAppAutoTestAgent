# Copy to .env. Never commit the filled file.
DEEPSEEK_API_KEY=
WAAT_MODEL_BASE_URL=https://api.deepseek.com
WAAT_API_MODEL=deepseek-flash
WAAT_DATA_DIR=.waat
WAAT_HEADLESS=true
WAAT_RUN_TIMEOUT_SECONDS=600
WAAT_MODEL_TIMEOUT_SECONDS=60
# Optional: use an installed Chrome executable instead of Playwright's Chromium.
# WAAT_BROWSER_EXECUTABLE=/usr/bin/google-chrome
# Application credentials are referenced by environment-variable name in profiles.
BOARDS_USERNAME=demo
BOARDS_PASSWORD=demo
