{
  // ---------------------------------------------------------------- 编辑器手感 / 视觉风格
  "editor.cursorSmoothCaretAnimation": "on", // 光标移动带缓动动画
  "editor.cursorBlinking": "expand",
  "editor.cursorWidth": 2,
  "editor.cursorSurroundingLines": 8, // 光标上下始终留出可见行
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.smoothScrolling": true, // 平滑滚动
  "editor.mouseWheelZoom": true, // Ctrl + 滚轮缩放字号
  "editor.renderLineHighlight": "all",
  "editor.renderWhitespace": "boundary",
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'SF Mono', 'Noto Sans Mono CJK SC', Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": 0.2,
  "editor.tabSize": 2,
  "editor.detectIndentation": false, // 统一由本文件与 .editorconfig 决定缩进
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "editor.wordWrapColumn": 100,
  "editor.stickyScroll.enabled": true,
  "editor.linkedEditing": true,
  "editor.suggest.preview": true,
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.minimap.renderCharacters": false,
  "editor.minimap.maxColumn": 100,
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.autoIndent": "full",
  "editor.formatOnPaste": false,
  "editor.formatOnSave": true,
  "editor.trimAutoWhitespace": true,

  // ---------------------------------------------------------------- 文件与编码（对齐 .editorconfig）
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/.waat": true,
    "**/.tools": true,
    "**/targets": true,
    "**/report/build": true,
    "**/dist": true,
    "**/pnpm-lock.yaml": true,
    "**/uv.lock": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/targets/**": true,
    "**/.tools/**": true
  },

  // ---------------------------------------------------------------- 资源管理器 / 工作台
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "pyproject.toml": "uv.lock, .python-version, alembic.ini, .pre-commit-config.yaml",
    "package.json": "pnpm-lock.yaml, .npmrc, pnpm-workspace.yaml, tsconfig.json, vite.config.ts, vitest.config.ts, eslint.config.js, .prettierrc.json, playwright.config.ts",
    ".env": ".env.example"
  },
  "workbench.tree.indent": 16,
  "workbench.editor.highlightModifiedTabs": true,
  "breadcrumbs.enabled": true,
  "problems.sortOrder": "severity",
  "git.autofetch": true,
  "git.branchProtection": ["main"],

  // ---------------------------------------------------------------- Python（ruff + mypy + pytest）
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingTypeStubs": "none"
  },
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests", "-q"],
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [100],
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.lineLength": 100,

  // ---------------------------------------------------------------- 前端（Vue / TS，prettier + eslint）
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.validate": ["javascript", "typescript", "vue"],
  "eslint.run": "onType",
  "prettier.requireConfig": true,
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "shortest",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
  },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.rulers": [],
    "files.trimTrailingWhitespace": false
  },
  // LaTeX：关闭保存时格式化，避免 LaTeX Workshop 每次保存弹出「未设置 formatter」提示
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false
  },

  // ---------------------------------------------------------------- 终端
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.cwd": "${workspaceFolder}",
  "python.terminal.activateEnvironment": true,

  // ---------------------------------------------------------------- latex
  // 产物输出到根文件同级的 build/，与 `uv run waat report build` 的 -outdir=build 保持一致；
  // 相对路径以根文件所在目录为基准（report/proposal/main.tex → report/proposal/build/）
  "latex-workshop.latex.outDir": "build",
  // 编译工具和命令；%OUTDIR%/%AUXDIR% 由上面的 outDir 展开，确保工具真正写到 build/
  "latex-workshop.latex.tools": [
    {
      "name": "xelatexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-xelatex",
        "-outdir=%OUTDIR%",
        "-auxdir=%AUXDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=%OUTDIR%",
        "%DOCFILE%"
      ]
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=%OUTDIR%",
        "%DOCFILE%"
      ]
    },
    // bibtex/biber 在 outDir 内执行才能读到 .aux/.bcf
    { "name": "bibtex", "command": "bibtex", "args": ["%DOCFILE%"], "cwd": "%OUTDIR%" },
    { "name": "biber", "command": "biber", "args": ["%DOCFILE%"], "cwd": "%OUTDIR%" }
  ],
  // 设置编译方法（新版 BibLaTeX 默认用 biber 处理参考文献）；
  // ctexbeamer 需要 XeLaTeX，故默认用第一条 xelatexmk
  "latex-workshop.latex.recipes": [
    { "name": "xelatexmk", "tools": ["xelatexmk"] },
    { "name": "pdflatex", "tools": ["pdflatex"] },
    { "name": "xe->biber->xe->xe", "tools": ["xelatex", "biber", "xelatex", "xelatex"] },
    { "name": "pdf->biber->pdf->pdf", "tools": ["pdflatex", "biber", "pdflatex", "pdflatex"] }
  ],
  "latex-workshop.latex.recipe.default": "xelatexmk",
  // 保存时不自动编译
  "latex-workshop.latex.autoBuild.run": "never",
  // 编译时自动删除中间文件（建议保留 *.aux、*.bbl、*.out 以加快 xelatex 编译速度）
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "latex-workshop.latex.clean.fileTypes": [
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.ist",
    "*.fls",
    "*.log",
    "*.fdb_latexmk"
  ],

  // ---------------------------------------------------------------- 其它
  "gitlens.codeLens.enabled": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "telemetry.telemetryLevel": "off"
}
