  "components": {
    "schemas": {
      "Application": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "base_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Base Url"
          },
          "username_env": {
            "type": "string",
            "title": "Username Env",
            "default": ""
          },
          "password_env": {
            "type": "string",
            "title": "Password Env",
            "default": ""
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": ""
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["name", "base_url", "username_env", "password_env", "version", "id"],
        "title": "Application"
      },
      "ApplicationInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "base_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Base Url"
          },
          "username_env": {
            "type": "string",
            "title": "Username Env",
            "default": ""
          },
          "password_env": {
            "type": "string",
            "title": "Password Env",
            "default": ""
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["name", "base_url"],
        "title": "ApplicationInput"
      },
      "Checkpoint": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "title": "Expected"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "satisfied", "violated"],
            "title": "Status",
            "default": "pending"
          },
          "actual": {
            "type": "string",
            "title": "Actual",
            "default": ""
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "expected", "status", "actual", "evidence_ids"],
        "title": "Checkpoint"
      },
      "Event": {
        "properties": {
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["sequence", "run_id", "kind", "created_at", "data"],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportScenarios": {
        "properties": {
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/ScenarioInput"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Scenarios"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["scenarios"],
        "title": "ImportScenarios"
      },
      "Observation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "aria": {
            "type": "string",
            "title": "Aria"
          },
          "screenshot": {
            "type": "string",
            "title": "Screenshot"
          },
          "snapshot": {
            "type": "string",
            "title": "Snapshot"
          },
          "controls": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Controls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "created_at",
          "url",
          "title",
          "aria",
          "screenshot",
          "snapshot",
          "controls"
        ],
        "title": "Observation"
      },
      "Report": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          },
          "application": {
            "$ref": "#/components/schemas/Application"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "checkpoints": {
            "items": {
              "$ref": "#/components/schemas/Checkpoint"
            },
            "type": "array",
            "title": "Checkpoints"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Observations"
          },
          "resources": {
            "$ref": "#/components/schemas/Resources"
          },
          "trace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace"
          },
          "execution_mode": {
            "type": "string",
            "title": "Execution Mode"
          },
          "model": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "scenario",
          "application",
          "status",
          "verdict",
          "reason",
          "checkpoints",
          "observations",
          "resources",
          "trace",
          "execution_mode",
          "model"
